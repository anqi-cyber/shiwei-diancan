.page {
  min-height: 100vh;
  background: #f7f3ee;
  padding-bottom: 60rpx;
}

/* 用户卡片 */
.hero {
  position: relative;
  padding: 40rpx 32rpx 70rpx;
  background: linear-gradient(150deg, #ff9a5a, #f4511e 70%);
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.user {
  position: relative;
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex: none;
  box-shadow: 0 8rpx 20rpx rgba(120, 40, 0, 0.18);
}

.user-main {
  margin-left: 24rpx;
  color: #fff;
  min-width: 0;
}

.nick {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sub {
  font-size: 22rpx;
  opacity: 0.86;
  margin-top: 6rpx;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  margin: -46rpx 24rpx 20rpx;
  position: relative;
  z-index: 2;
  padding: 28rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: #f1ece6;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #1e2128;
  line-height: 1.2;
}

.stat-yuan {
  font-size: 22rpx;
  font-weight: 600;
}

.stat-label {
  font-size: 20rpx;
  color: #9aa0ac;
  margin-top: 4rpx;
}

/* 快捷入口 */
.grid {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 28rpx 0;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #fff6ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.grid-label {
  font-size: 22rpx;
  color: #5c6270;
  margin-top: 12rpx;
}

/* 列表 */
.list {
  margin: 0 24rpx;
  padding: 6rpx 28rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f6f2ec;
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.list-title {
  font-size: 26rpx;
  color: #1e2128;
  flex: 1;
}

.list-desc {
  font-size: 21rpx;
  color: #b4b9c2;
  margin-right: 10rpx;
}

.list-arrow {
  color: #c9cdd4;
  font-size: 28rpx;
}

/* 页脚 */
.footer {
  text-align: center;
  padding: 50rpx 0 20rpx;
}

.footer-name {
  font-size: 24rpx;
  color: #9aa0ac;
  letter-spacing: 2rpx;
}

.footer-ver {
  font-size: 19rpx;
  color: #c3c7ce;
  margin-top: 4rpx;
}
