/* ============ 设计变量 ============ */
page {
  --brand: #F4511E;
  --brand-light: #FF8A4C;
  --brand-soft: #FFF1E9;
  --ink: #1E2128;
  --ink-2: #5C6270;
  --ink-3: #9AA0AC;
  --line: #F1ECE6;
  --bg: #F7F3EE;
  --green: #21A366;
  --red: #E5484D;
  --gold: #F5A623;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
scroll-view,
input,
textarea,
picker,
button {
  box-sizing: border-box;
}

/* ============ 通用布局 ============ */
.row {
  display: flex;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.muted {
  color: var(--ink-3);
}

.small {
  font-size: 22rpx;
}

.bold {
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}

.page-pad {
  padding: 24rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
}

/* ============ 价格 ============ */
.price {
  color: var(--brand);
  font-weight: 700;
}

.yuan {
  font-size: 22rpx;
  margin-right: 2rpx;
  font-weight: 600;
}

/* ============ 按钮 ============ */
.btn-primary {
  background: linear-gradient(135deg, #FF8A4C, #F4511E);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(244, 81, 30, 0.26);
}

.btn-primary.disabled {
  background: #E8E3DC;
  color: #B4B9C2;
  box-shadow: none;
}

.btn-ghost {
  background: #fff;
  border: 1rpx solid #E9E4DD;
  color: var(--ink-2);
  border-radius: 999rpx;
  height: 64rpx;
  padding: 0 30rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost.brand {
  color: var(--brand);
  border-color: #FFD3BE;
  background: var(--brand-soft);
}

.btn-mini {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF8A4C, #F4511E);
  color: #fff;
  font-weight: 600;
}

/* ============ 标签 ============ */
.tag {
  font-size: 18rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  font-weight: 400;
  flex: none;
}

.tag-hot {
  color: #E85525;
  background: #FFF0E8;
}

.tag-spicy {
  color: #D4380D;
  background: #FFF1F0;
}

.tag-green {
  color: #21A366;
  background: #EAF7F0;
}

/* ============ 空状态 ============ */
.empty {
  padding: 120rpx 0 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--ink-3);
  font-size: 26rpx;
}

.empty-emoji {
  font-size: 92rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.empty-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #B4B9C2;
}

/* ============ 底部操作栏 ============ */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 41, 0.06);
  display: flex;
  align-items: center;
  z-index: 20;
}
